{
    "mcpServers": {
        "tauri": {
            "command": "npx",
            "args": [
                "-y",
                "@hypothesi/tauri-mcp-server"
            ],
            "env": {
                "TAURI_MCP_HOST": "127.0.0.1"
            }
        },
        "cargo": {
            "command": "cargo-mcp",
            "args": [
                "serve"
            ],
            "env": {
                "CARGO_MCP_DEFAULT_TOOLCHAIN": "stable"
            }
        },
        "semgrep": {
            "command": "uvx",
            "args": [
                "semgrep-mcp"
            ],
            "env": {
                "MCP_SERVER_SEMGREP_ALLOWED_ROOTS": "D:/FERRO"
            }
        },
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "D:/FERRO"
            ]
        },
        "sqlite": {
            "command": "uvx",
            "args": [
                "mcp-server-sqlite",
                "--db-path",
                "D:/FERRO/src-tauri/dev-data/ferro_dev.db"
            ]
        },
        "git": {
            "command": "uvx",
            "args": [
                "mcp-server-git",
                "--repository",
                "D:/FERRO"
            ]
        }
    }
}