{
  "compilerOptions": {
    "target": "ES2020",
    "useUnknownInConstraintVariables": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "imports": {
      "transforms": ["typescript"]
    },
    "paths": {
      "$lib": ["./src/lib"]
    }
  },
  "include": ["src"]
}